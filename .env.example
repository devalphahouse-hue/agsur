# Variáveis opcionais para builds Flutter (Painel + App).
# Quando vazias, os valores hardcoded em lib/backend/supabase/supabase.dart
# são usados como fallback (anon key é pública por design Supabase).
#
# Uso (build):
#   flutter build web --release \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Uso (run):
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# Para apontar para um projeto Supabase diferente (staging/preview), defina ambas.

SUPABASE_URL=https://bkzybtmxxzpxtztesdye.supabase.co
SUPABASE_ANON_KEY=eyJ...

# === Observabilidade ===
# DSN do projeto Sentry (https://sentry.io). Sem isso, runWithSentry vira no-op.
# Crie 2 projetos no Sentry: agsur-painel (Flutter web) e agsur-app (Flutter mobile).
SENTRY_DSN=

# Identifica o ambiente nos eventos do Sentry.
APP_ENV=development

# Versão do release — útil pra correlacionar crash com commit.
# Em CI: passar git short-sha. Em dev: deixar vazio.
APP_RELEASE=
